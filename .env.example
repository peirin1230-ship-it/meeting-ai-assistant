# Anthropic Claude API Key (required)
# Get yours at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# App Configuration
NEXT_PUBLIC_APP_NAME=Meeting AI Assistant

# Cost limit per session in USD (optional, default: 1.00)
COST_LIMIT_PER_SESSION=1.00

# Upstash Redis (optional: スマホ↔PC のクロスデバイス同期に必要)
# https://console.upstash.com で作成
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
